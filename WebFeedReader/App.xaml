<prism:PrismApplication
    x:Class="WebFeedReader.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:system="clr-namespace:System;assembly=System.Runtime">



    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Dark"
                    PrimaryColor="Cyan"
                    SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="LightBorderBrush" Color="LightSlateGray" />
            <SolidColorBrush x:Key="MediumBackgroundBrush" Color="#555588" />
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#333333" />
            <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#444444" />

            <Color x:Key="IndicatorColor">
                DarkOrange
            </Color>
            <SolidColorBrush x:Key="CommonForegroundBrush" Color="GhostWhite" />

            <Color x:Key="LightBackgroundColor">
                #444444
            </Color>

            <Color x:Key="MouseOverBackgroundColor">
                #525252
            </Color>

            <SolidColorBrush x:Key="DarkBackgroundColor">
                #333333
            </SolidColorBrush>
            <system:Double x:Key="CommonFontSize">15</system:Double>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>